      {
        "name": "request_access",
        "title": "Conceder / revogar acesso",
        "description": "Concede ou revoga acessos (perfil de acesso, grupo, licença, app ou pasta SharePoint) para um colaborador ou terceiro. Gera itens na fila IAM (aguardando aprovação quando o modo aprovação está ligado) que o Órigo Agente executa. Use para chamados do GLPI. Informe colaborador_id OU terceiro_id e o motivo (número do chamado).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "colaborador_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "terceiro_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "conceder": {
              "description": "Recursos/perfis a conceder",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "grupo",
                      "licenca",
                      "app",
                      "sharepoint",
                      "perfil"
                    ],
                    "description": "perfil = perfil de acesso; os demais são recursos individuais"
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "id do catálogo (entra_grupos.id, entra_licencas.id, aplicacoes.id, sharepoint_sites.id ou perfis_acesso.id) — use list_catalog para resolver nomes"
                  },
                  "pasta_id": {
                    "description": "sharepoint: pasta (sharepoint_pastas.id); omitido = raiz do site",
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "permissao": {
                    "description": "sharepoint: padrão leitura",
                    "type": "string",
                    "enum": [
                      "leitura",
                      "edicao"
                    ]
                  }
                },
                "required": [
                  "tipo",
                  "id"
                ]
              }
            },
            "revogar": {
              "description": "Recursos/perfis a revogar",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tipo": {
                    "type": "string",
                    "enum": [
                      "grupo",
                      "licenca",
                      "app",
                      "sharepoint",
                      "perfil"
                    ],
                    "description": "perfil = perfil de acesso; os demais são recursos individuais"
                  },
                  "id": {
                    "type": "string",
