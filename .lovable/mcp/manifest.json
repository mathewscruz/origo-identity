      {
        "name": "run_admin_sql",
        "title": "Executar SQL admin",
        "description": "Executa uma consulta SELECT arbitrária no banco Postgres do Órigo, retornando as linhas em JSON. Requer papel admin do usuário conectado. Toda execução é gravada na tabela auditoria automaticamente. Use com cautela — não há sandbox.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1,
              "description": "SQL a executar. Deve ser uma expressão que retorne linhas (SELECT ... ou CTE terminando em SELECT)."
            }
          },
          "required": [
            "sql"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "apply_migration",
        "title": "Aplicar migração (DDL)",
        "description": "Executa comandos DDL/DML arbitrários (CREATE/ALTER TABLE, políticas RLS, funções, triggers, INSERT/UPDATE/DELETE em qualquer tabela). Requer papel admin. Sempre inclua GRANTs após CREATE TABLE em schema public, ENABLE RLS e CREATE POLICY (padrão obrigatório do projeto). Toda execução é auditada.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1,
              "description": "SQL DDL/DML completo. Pode conter múltiplas statements separadas por ';'."
            },
            "description": {
              "type": "string",
              "minLength": 3,
              "description": "Descrição curta e clara do que a migração faz (para a auditoria)."
            }
          },
          "required": [
            "sql",
            "description"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "introspect_schema",
        "title": "Introspecção do schema",
        "description": "Retorna metadados do banco: lista de tabelas, colunas, políticas RLS, índices ou funções. Requer papel admin.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tables",
                "columns",
                "policies",
                "indexes",
                "functions"
              ]
            },
            "schema": {
              "description": "Padrão: 'public'",
              "type": "string"
            },
            "table": {
              "description": "Nome da tabela (para kind=columns/policies/indexes).",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "invoke_edge_function",
        "title": "Invocar Edge Function",
        "description": "Chama qualquer Edge Function do projeto Órigo (ex.: reconcile-identities, process-iam-queue, sync-entra-groups, start-jml-event, etc.). Encaminha o JWT do usuário conectado — a função-alvo aplica suas próprias regras. Requer papel admin.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Nome da edge function (sem prefixo)."
            },
            "payload": {
              "description": "Corpo JSON opcional a enviar."
            },
            "method": {
              "description": "Padrão POST.",
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH"
              ]
            }
          },
          "required": [
            "name"
          ]
        },
