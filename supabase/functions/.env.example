# Copie para supabase/functions/.env (arquivo ignorado pelo git) e preencha.
# Usado por: supabase functions serve --env-file supabase/functions/.env
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY são injetados
# automaticamente pelo `supabase functions serve` — não precisa definir aqui.

# Microsoft Graph / Entra ID — SOMENTE LEITURA (sync-entra-*, sync-sharepoint-*, reconcile-identities,
# sync-user-access). Toda escrita em AD/Entra/SharePoint é do Órigo Agente (agent/).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# E-mail (send-review-email, send-notification-email)
SENDGRID_API_KEY=

# Token compartilhado com o Órigo Agente — único executor (iam-agent-api)
IAM_AGENT_TOKEN=

# URL pública do frontend usada em links de e-mail
SITE_URL=http://localhost:8080
